manifest.version = '0.2.0'
params.version = manifest.version

profiles {
  standard {
    process {
      beforeScript =  '. /etc/profile.d/modules.sh'
      executor = "sge"
      errorStrategy = "finish"
      maxForks = 30

      queue_short = "shendure-short.q"
      queue_long  = "shendure-long.q"

      withName: run_check_samplesheet {
        module = 'modules:modules-init:modules-gs:python/3.12.1'
        memory = '16 GB'
        queue = queue_short
        time = 4.h
      }

      withName: make_cram2bam_json {
        module = 'modules:modules-init:modules-gs:python/3.12.1'
        memory = '16 GB'
        queue = queue_short
        time = 4.h
      }

      withName: run_cram2bam {
        cpus = 4
        memory = '8 GB'
        penv = 'serial'
        queue = queue_short
        time = 4.h
      }
    } // end of process
  }  // end of standard profile

}  // end of profiles
